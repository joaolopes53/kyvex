---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import Work from '../components/Work.astro';
import Team from '../components/Team.astro';
import Experience from '../components/Experience.astro';
import Testimonials from '../components/Testimonials.astro';
import Contact from '../components/Contact.astro';
import Cursor from '../components/Cursor.astro';
import LoadingScreen from '../components/LoadingScreen.astro';
---

<Base
  title="Kyvex | Software studio"
  description="João Rodrigues and Diogo Gonçalves design and build web platforms, APIs and internal tools."
>
  <LoadingScreen />
  <canvas class="space" data-space aria-hidden="true"></canvas>
  <div class="space-fallback" aria-hidden="true"></div>
  <Header />
  <main id="main">
    <Hero />
    <Statement />
    <Work />
    <Team />
    <Experience />
    <Testimonials />
  </main>
  <Contact />
  <Cursor />
</Base>

<script>
  import { initCursor } from '../motion/cursor';
  import { initMotion } from '../motion/init';
  import { mountSpace } from '../three/space';

  const markNoWebgl = (): void => document.documentElement.classList.add('no-webgl');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-space]');
  const space = canvas ? mountSpace({ canvas, onLost: markNoWebgl }) : null;
  if (!space) markNoWebgl();

  initMotion({
    onHeroProgress: (progress) => space?.setHero(progress),
    onJourneyProgress: (progress) => space?.setJourney(progress),
    onFinaleProgress: (progress) => space?.setFinale(progress),
  });
  initCursor();
</script>
