---
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<section class="work" id="work" data-work aria-labelledby="work-title">
  <div class="work__viewport">
    <div class="work__track" data-work-track>
      <header class="work__intro">
        <p class="label">Selected work</p>
        <h2 class="work__title section-title" id="work-title" data-reveal-lines>Worlds we have built.</h2>
      </header>
      {
        projects.map((project, index) => (
          <article class="card">
            <div class="card__visual" data-card-visual aria-hidden="true">
              <img src={project.data.image} alt="" loading="lazy" decoding="async" />
            </div>
            <div class="card__body">
              <p class="label">
                {String(index + 1).padStart(2, '0')} | {project.data.category}
              </p>
              <h3 class="item-title">{project.data.title}</h3>
              <p class="card__summary">{project.data.summary}</p>
              <a class="card__link label" href={project.data.url} target="_blank" rel="noopener noreferrer">
                Visit website
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .work {
    padding-block: var(--section-space);
  }

  .work__track {
    display: grid;
    gap: 3rem;
    padding-inline: var(--gutter);
  }

  .work__title {
    margin-top: 1.5rem;
  }

  .card {
    display: grid;
    gap: 1.5rem;
  }

  .card__visual {
    aspect-ratio: 16 / 10;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .card__visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 0.8s var(--ease-out);
  }

  .card:hover .card__visual img {
    transform: scale(1.04);
  }

  .card__body {
    display: grid;
    gap: 0.75rem;
  }

  .card__summary {
    color: var(--color-muted);
    max-width: 28rem;
  }

  .card__link {
    justify-self: start;
    color: var(--color-accent);
    text-underline-offset: 0.35em;
  }

  .card__link:hover {
    color: var(--color-text);
  }

  /* The horizontal strip exists only while its pin runs, so every card stays reachable without it. */
  :global(.is-horizontal) .work {
    padding-block: 0;
  }

  :global(.is-horizontal) .work__viewport {
    overflow: clip;
  }

  :global(.is-horizontal) .work__track {
    display: flex;
    align-items: center;
    gap: clamp(2rem, 4vw, 5rem);
    width: max-content;
    height: 100svh;
  }

  :global(.is-horizontal) .work__intro {
    width: min(30rem, 35vw);
  }

  /* 70svh keeps a 16:10 visual plus the card text inside one viewport height. */
  :global(.is-horizontal) .card {
    width: min(34rem, 38vw, 70svh);
  }

  @media (min-width: 900px) {
    .work__track {
      grid-template-columns: repeat(2, 1fr);
      column-gap: clamp(2rem, 4vw, 5rem);
    }

    .work__intro {
      grid-column: 1 / -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card__visual img {
      transition: none;
    }
  }
</style>
